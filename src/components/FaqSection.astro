---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  currentLocale?: Locale;
}

const { currentLocale = 'en' } = Astro.props;
const t = translations[currentLocale] || translations.en;
const faq = t.faq || translations.en.faq;
---

<section id="faq" itemscope itemtype="https://schema.org/FAQPage" class="py-16 bg-slate-50/50 border-t border-slate-200/80">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-cyan-700">{faq.tag}</span>
      <h2 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl mt-1">
        {faq.title}
      </h2>
      <p class="text-base text-slate-600 mt-3">
        {faq.subtitle}
      </p>
    </div>

    <div class="space-y-4">
      {faq.items.map((item, idx) => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs transition-all hover:border-slate-300">
          <h3 itemprop="name" class="text-lg font-bold text-slate-900 flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-xs font-black text-cyan-800">{idx + 1}</span>
            <span>{item.q}</span>
          </h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer" class="mt-3 pl-9">
            <p itemprop="text" class="text-sm text-slate-600 leading-relaxed">
              {item.a}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
