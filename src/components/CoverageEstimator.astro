---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const t = translations[currentLocale] || translations.en;
const cov = t.coverage;
---

<section id="coverage" class="py-16 bg-slate-50/60 border-t border-slate-200/80">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="mx-auto max-w-3xl text-center mb-10">
      <span class="text-xs font-bold uppercase tracking-wider text-cyan-700">{cov.eyebrow}</span>
      <h2 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl mt-1">
        {cov.title}
      </h2>
      <p class="text-base text-slate-600 mt-2">
        {cov.subtitle}
      </p>
    </div>

    <div class="mx-auto max-w-4xl grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      
      {/* Inputs (7 cols) */}
      <div class="md:col-span-7 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs space-y-5">
        
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700">{cov.surfaceDimensions}</span>
          <div class="flex items-center gap-1.5">
            <label for="cov-unit-select" class="text-xs font-semibold text-slate-500">{cov.unit}:</label>
            <select id="cov-unit-select" class="rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-bold text-slate-800 focus:outline-none focus:border-cyan-600 cursor-pointer">
              <option value="cm" selected>{t.calculator.units.cm}</option>
              <option value="in">{t.calculator.units.in}</option>
              <option value="m">{t.calculator.units.m}</option>
              <option value="ft">{t.calculator.units.ft}</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="cov-input-length" class="block text-xs font-bold text-slate-700 mb-1">
              {cov.length} (<span class="cov-unit-label">cm</span>)
            </label>
            <input 
              type="number" 
              id="cov-input-length" 
              min="0.1" 
              step="any" 
              value="100" 
              class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 tabular-nums focus:border-cyan-600 focus:bg-white focus:outline-none"
              aria-label="Surface length"
            />
          </div>
          <div>
            <label for="cov-input-width" class="block text-xs font-bold text-slate-700 mb-1">
              {cov.width} (<span class="cov-unit-label">cm</span>)
            </label>
            <input 
              type="number" 
              id="cov-input-width" 
              min="0.1" 
              step="any" 
              value="60" 
              class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 tabular-nums focus:border-cyan-600 focus:bg-white focus:outline-none"
              aria-label="Surface width"
            />
          </div>
        </div>

        {/* Coating Thickness & Presets */}
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="cov-input-depth" class="text-xs font-bold text-slate-700">
              {cov.depth} (mm)
            </label>
            <span class="text-[11px] text-slate-400">1 mm ≈ 1/25" • 2 mm ≈ 1/12"</span>
          </div>

          <div class="grid grid-cols-3 gap-2 mb-2.5">
            <button type="button" class="cov-preset-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-mm="1">
              {cov.presets.seal}
            </button>
            <button type="button" class="cov-preset-btn rounded-lg border-2 border-cyan-600 bg-cyan-50/80 py-1.5 text-xs font-bold text-cyan-900 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-mm="2">
              {cov.presets.flood}
            </button>
            <button type="button" class="cov-preset-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-mm="3">
              {cov.presets.art}
            </button>
          </div>

          <input 
            type="number" 
            id="cov-input-depth" 
            min="0.1" 
            max="25" 
            step="0.1" 
            value="2.0" 
            class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2 text-sm font-semibold text-slate-900 tabular-nums focus:border-cyan-600 focus:bg-white focus:outline-none"
            aria-label="Coating thickness in mm"
          />
        </div>

        {/* Waste factor buffer */}
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">{cov.safetyBufferLabel}</label>
          <div class="flex items-center gap-2">
            <button type="button" class="cov-waste-btn flex-1 rounded-lg border border-slate-200 bg-slate-50 py-1 text-xs font-bold text-slate-700" data-waste="0">0%</button>
            <button type="button" class="cov-waste-btn flex-1 rounded-lg border border-slate-200 bg-slate-50 py-1 text-xs font-bold text-slate-700" data-waste="5">5%</button>
            <button type="button" class="cov-waste-btn flex-1 rounded-lg border-2 border-cyan-600 bg-cyan-50/80 py-1 text-xs font-bold text-cyan-900" data-waste="10">10%</button>
            <button type="button" class="cov-waste-btn flex-1 rounded-lg border border-slate-200 bg-slate-50 py-1 text-xs font-bold text-slate-700" data-waste="15">15%</button>
          </div>
        </div>

      </div>

      {/* Results Display (5 cols) */}
      <div class="md:col-span-5 rounded-2xl border-2 border-slate-900 bg-slate-900 text-white p-6 shadow-xl relative overflow-hidden flex flex-col justify-between">
        <div class="space-y-5">
          
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-300">{cov.resultTitle}</span>
            <span class="rounded bg-cyan-950 border border-cyan-800 px-2 py-0.5 text-[10px] font-bold text-cyan-300">
              {cov.badgeCoating}
            </span>
          </div>

          {/* Total Surface Area */}
          <div class="rounded-xl bg-slate-800/80 border border-slate-700/60 p-3 flex justify-between items-center text-xs">
            <span class="text-slate-400 font-medium">{cov.surfaceArea}:</span>
            <div class="text-right">
              <span id="cov-res-area-m2" class="text-sm font-black text-white tabular-nums">0.60 m²</span>
              <span id="cov-res-area-sqft" class="text-[11px] text-slate-400 block tabular-nums">(6.46 sq ft)</span>
            </div>
          </div>

          {/* Required Volume */}
          <div>
            <span class="block text-xs font-medium text-slate-400 mb-1">{cov.withWaste}:</span>
            <div class="flex items-baseline gap-2">
              <span id="cov-res-vol-ml" class="text-4xl font-black text-white tabular-nums tracking-tight">
                1,320
              </span>
              <span class="text-xl font-bold text-cyan-400">ml</span>
              <span class="text-slate-500 font-semibold">/</span>
              <span id="cov-res-vol-liters" class="text-lg font-bold text-slate-300 tabular-nums">1.32 L</span>
            </div>
            <div class="mt-1 text-xs text-slate-400">
              {cov.equivalent}: <span id="cov-res-vol-floz" class="font-bold text-slate-300 tabular-nums">44.6 fl oz</span> • <span id="cov-res-vol-gal" class="font-bold text-slate-300 tabular-nums">0.35 gal</span>
            </div>
          </div>

          {/* Batch Weight */}
          <div class="rounded-xl bg-slate-800/80 border border-slate-700/60 p-3 flex justify-between items-center text-xs">
            <span class="text-slate-400 font-medium">{cov.batchWeight}:</span>
            <div class="text-right">
              <span id="cov-res-weight-g" class="text-sm font-black text-cyan-300 tabular-nums">1,478 g</span>
              <span id="cov-res-weight-lbs" class="text-[11px] text-slate-400 block tabular-nums">(3.26 lbs)</span>
            </div>
          </div>

        </div>

        <p class="mt-5 flex items-start gap-1.5 text-[11px] leading-relaxed text-slate-400 border-t border-slate-800 pt-3">
          <svg class="h-3.5 w-3.5 text-amber-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
            <path d="M9 18h6"/>
            <path d="M10 22h4"/>
          </svg>
          <span>{cov.ruleOfThumb}</span>
        </p>

      </div>

    </div>

  </div>
</section>

<script is:inline>
  (function() {
    var factors = { cm: 1, in: 2.54, m: 100, ft: 30.48 };
    var ML_PER_FL_OZ = 29.5735295625;
    var ML_PER_GAL = 3785.411784;
    var G_PER_LB = 453.59237;

    var unitSelect = document.getElementById('cov-unit-select');
    var inputLen = document.getElementById('cov-input-length');
    var inputWid = document.getElementById('cov-input-width');
    var inputDepth = document.getElementById('cov-input-depth');
    var presetBtns = document.querySelectorAll('.cov-preset-btn');
    var wasteBtns = document.querySelectorAll('.cov-waste-btn');

    var resAreaM2 = document.getElementById('cov-res-area-m2');
    var resAreaSqft = document.getElementById('cov-res-area-sqft');
    var resVolMl = document.getElementById('cov-res-vol-ml');
    var resVolL = document.getElementById('cov-res-vol-liters');
    var resVolFloz = document.getElementById('cov-res-vol-floz');
    var resVolGal = document.getElementById('cov-res-vol-gal');
    var resWeightG = document.getElementById('cov-res-weight-g');
    var resWeightLbs = document.getElementById('cov-res-weight-lbs');

    var currentWaste = 10;

    function toCm(val, unit) {
      var n = parseFloat(val);
      if (isNaN(n) || n < 0) return 0;
      return n * (factors[unit] || 1);
    }

    function format(val, dec) {
      if (isNaN(val) || !isFinite(val)) return '0';
      return val.toLocaleString('en-US', {
        minimumFractionDigits: 0,
        maximumFractionDigits: dec !== undefined ? dec : 2
      });
    }

    function calculateCoverage() {
      var u = unitSelect.value;
      var lenCm = toCm(inputLen.value, u);
      var widCm = toCm(inputWid.value, u);
      var depthMm = parseFloat(inputDepth.value) || 0;

      var areaM2 = (lenCm * widCm) / 10000;
      var areaSqFt = areaM2 * 10.7639;

      var rawVolMl = (lenCm * widCm) * (depthMm / 10);
      var totalVolMl = rawVolMl * (1 + currentWaste / 100);
      var weightG = totalVolMl * 1.12;

      resAreaM2.textContent = format(areaM2, 2) + ' m²';
      resAreaSqft.textContent = '(' + format(areaSqFt, 2) + ' sq ft)';
      resVolMl.textContent = format(totalVolMl, 0);
      resVolL.textContent = format(totalVolMl / 1000, 2) + ' L';
      resVolFloz.textContent = format(totalVolMl / ML_PER_FL_OZ, 1) + ' fl oz';
      resVolGal.textContent = format(totalVolMl / ML_PER_GAL, 2) + ' gal';
      resWeightG.textContent = format(weightG, 0) + ' g';
      resWeightLbs.textContent = '(' + format(weightG / G_PER_LB, 2) + ' lbs)';
    }

    unitSelect.addEventListener('change', function() {
      var labels = document.querySelectorAll('.cov-unit-label');
      for (var i = 0; i < labels.length; i++) labels[i].textContent = unitSelect.value;
      calculateCoverage();
    });

    inputLen.addEventListener('input', calculateCoverage);
    inputWid.addEventListener('input', calculateCoverage);
    inputDepth.addEventListener('input', calculateCoverage);

    for (var p = 0; p < presetBtns.length; p++) {
      presetBtns[p].addEventListener('click', function() {
        var mm = this.getAttribute('data-mm');
        inputDepth.value = mm;
        for (var j = 0; j < presetBtns.length; j++) {
          presetBtns[j].className = 'cov-preset-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 transition-all';
        }
        this.className = 'cov-preset-btn rounded-lg border-2 border-cyan-600 bg-cyan-50/80 py-1.5 text-xs font-bold text-cyan-900 transition-all';
        calculateCoverage();
      });
    }

    for (var w = 0; w < wasteBtns.length; w++) {
      wasteBtns[w].addEventListener('click', function() {
        currentWaste = parseFloat(this.getAttribute('data-waste')) || 0;
        for (var k = 0; k < wasteBtns.length; k++) {
          wasteBtns[k].className = 'cov-waste-btn flex-1 rounded-lg border border-slate-200 bg-slate-50 py-1 text-xs font-bold text-slate-700';
        }
        this.className = 'cov-waste-btn flex-1 rounded-lg border-2 border-cyan-600 bg-cyan-50/80 py-1 text-xs font-bold text-cyan-900';
        calculateCoverage();
      });
    }

    calculateCoverage();
  })();
</script>
