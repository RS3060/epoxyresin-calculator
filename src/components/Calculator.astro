                <input 
                  type="number" 
                  id="custom-ratio-a" 
                  min="0.1" 
                  step="any" 
                  value="2" 
                  class="w-full rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-900 tabular-nums focus:border-cyan-600 focus:outline-none"
