                <span id="display-total-floz" class="text-lg font-bold text-slate-300 tabular-nums">
                  33.5
                </span>
                <span class="text-xs font-semibold text-slate-400">fl oz</span>
              </div>

              {/* Total Batch Scale Weight */}
              <div class="mt-1.5 flex items-center gap-2 text-xs font-medium text-slate-400">
                <span>{c.results.totalWeight}:</span>
                <span id="display-total-weight-g" class="font-bold text-slate-200 tabular-nums">1,089</span>
                <span class="text-slate-400">g</span>
                <span class="text-slate-600">•</span>
                <span id="display-total-weight-lbs" class="font-bold text-slate-300 tabular-nums">2.40</span>
                <span class="text-slate-400">lbs</span>
              </div>
            </div>

            {/* Visual Proportion Gauge / Beaker Bar */}
            <div class="mb-6 space-y-1.5">
              <div class="flex justify-between text-[11px] font-semibold text-slate-400">
                <span>{c.results.fluidVisualLabel}</span>
                <span id="display-proportion-split" class="text-slate-300">66.7% A : 33.3% B</span>
              </div>
              <div class="h-3 w-full rounded-full bg-slate-800 p-0.5 flex overflow-hidden ring-1 ring-slate-700">
                <div id="bar-part-a" class="h-full rounded-l-full bg-gradient-to-r from-cyan-600 to-cyan-400 transition-all duration-300" style="width: 66.7%;"></div>
                <div id="bar-part-b" class="h-full rounded-r-full bg-gradient-to-r from-amber-500 to-amber-400 transition-all duration-300" style="width: 33.3%;"></div>
              </div>
            </div>

            {/* Split Components: Part A (Cyan) and Part B (Amber) Cards */}
            <div class="grid grid-cols-2 gap-3 mb-5">
              
              {/* Part A: Resin */}
              <div class="rounded-xl border border-cyan-500/30 bg-cyan-950/40 p-3.5 relative overflow-hidden backdrop-blur-xs">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-extrabold text-cyan-400 uppercase tracking-wide">
                    {c.partALabel}
                  </span>
                  <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
                </div>
                <div class="space-y-1">
                  <div>
                    <span class="text-[10px] text-slate-400 font-medium">{c.results.byVolume}</span>
                    <div class="flex items-baseline gap-1">
                      <span id="display-part-a-ml" class="text-xl sm:text-2xl font-black text-white tabular-nums">
                        660
                      </span>
                      <span class="text-xs font-bold text-cyan-400">ml</span>
                    </div>
                    <span id="display-part-a-floz" class="text-[11px] text-slate-400 tabular-nums">22.3 fl oz</span>
                  </div>
                  <div class="border-t border-cyan-800/40 pt-1.5 mt-1.5">
                    <span class="text-[10px] text-slate-400 font-medium">{c.results.byWeight}</span>
                    <div class="flex items-baseline gap-1">
                      <span id="display-part-a-grams" class="text-lg font-black text-cyan-200 tabular-nums">
                        759
                      </span>
                      <span class="text-xs font-bold text-cyan-400">g</span>
                    </div>
                    <span id="display-part-a-oz" class="text-[11px] text-slate-400 tabular-nums">26.8 oz</span>
                  </div>
                </div>
              </div>

              {/* Part B: Hardener */}
              <div class="rounded-xl border border-amber-500/30 bg-amber-950/40 p-3.5 relative overflow-hidden backdrop-blur-xs">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-extrabold text-amber-400 uppercase tracking-wide">
                    {c.partBLabel}
                  </span>
                  <span class="h-2 w-2 rounded-full bg-amber-400"></span>
                </div>
                <div class="space-y-1">
                  <div>
                    <span class="text-[10px] text-slate-400 font-medium">{c.results.byVolume}</span>
                    <div class="flex items-baseline gap-1">
                      <span id="display-part-b-ml" class="text-xl sm:text-2xl font-black text-white tabular-nums">
                        330
                      </span>
                      <span class="text-xs font-bold text-amber-400">ml</span>
                    </div>
                    <span id="display-part-b-floz" class="text-[11px] text-slate-400 tabular-nums">11.2 fl oz</span>
                  </div>
                  <div class="border-t border-amber-800/40 pt-1.5 mt-1.5">
                    <span class="text-[10px] text-slate-400 font-medium">{c.results.byWeight}</span>
                    <div class="flex items-baseline gap-1">
                      <span id="display-part-b-grams" class="text-lg font-black text-amber-200 tabular-nums">
                        330
                      </span>
                      <span class="text-xs font-bold text-amber-400">g</span>
                    </div>
                    <span id="display-part-b-oz" class="text-[11px] text-slate-400 tabular-nums">11.6 oz</span>
                  </div>
                </div>
              </div>

            </div>

            {/* Secondary Bulk Conversions Row */}
            <div class="rounded-xl bg-slate-800/80 border border-slate-700/60 p-3 text-xs mb-5">
              <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">
                {c.results.secondaryConversions}
              </span>
              <div class="grid grid-cols-4 gap-2 text-center text-slate-200">
                <div>
                  <span class="text-[10px] text-slate-400 block">{c.results.secondaryHeaders.liters}</span>
                  <span id="display-sec-liters" class="font-bold tabular-nums">0.99 L</span>
                </div>
                <div>
                  <span class="text-[10px] text-slate-400 block">{c.results.secondaryHeaders.gallons}</span>
                  <span id="display-sec-gallons" class="font-bold tabular-nums">0.26 gal</span>
                </div>
                <div>
                  <span class="text-[10px] text-slate-400 block">{c.results.secondaryHeaders.kilograms}</span>
                  <span id="display-sec-kg" class="font-bold tabular-nums">1.09 kg</span>
                </div>
                <div>
                  <span class="text-[10px] text-slate-400 block">{c.results.secondaryHeaders.pounds}</span>
                  <span id="display-sec-lbs" class="font-bold tabular-nums">2.40 lbs</span>
                </div>
              </div>
            </div>

          </div>

          {/* Bottom Actions: Copy Recipe Button & Toast */}
          <div>
            <button 
              type="button" 
              id="copy-recipe-btn"
              class="w-full flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-500 px-4 py-3 text-sm font-bold text-white shadow-lg shadow-cyan-900/30 hover:from-cyan-500 hover:to-cyan-400 focus-visible:outline-2 focus-visible:outline-white active:scale-[0.99] transition-all cursor-pointer"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              <span id="copy-btn-label">{c.results.copyRecipe}</span>
            </button>

            {/* Copied Toast Confirmation */}
            <div id="copy-toast" class="mt-2 flex items-center justify-center gap-1.5 text-center text-xs font-semibold text-emerald-400 opacity-0 transition-opacity duration-300">
              <svg class="h-3.5 w-3.5 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>{c.results.copiedNotice}</span>
            </div>

            {/* Mandatory Compliance Disclaimer */}
            <p class="mt-3 flex items-start gap-1.5 text-[11px] leading-normal text-slate-400 border-t border-slate-800 pt-3">
              <svg class="h-3.5 w-3.5 text-slate-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/>
                <path d="M2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/>
                <path d="M7 21h10"/>
                <path d="M12 3v18"/>
                <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
              </svg>
              <span>{c.results.disclaimer}</span>
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

{/* Hidden Translation Data for Calculation Script */}
<div 
  id="calculator-i18n-data" 
  class="hidden"
  data-length={c.length}
  data-table-length={c.tableLength}
  data-buffer={c.bufferBadge}
  data-ratio={c.ratioLabel}
></div>

{/* Pure Vanilla Lightweight Calculation Script (<3KB, No Frameworks, Zero FOIT/FOUT) */}
<script is:inline>
  (function() {
    var i18nData = document.getElementById('calculator-i18n-data');
    var STR_LENGTH = i18nData ? i18nData.getAttribute('data-length') : 'Length';
    var STR_TABLE_LENGTH = i18nData ? i18nData.getAttribute('data-table-length') : 'Table Length';
    var STR_BUFFER = i18nData ? i18nData.getAttribute('data-buffer') : 'Buffer';
    var STR_RATIO = i18nData ? i18nData.getAttribute('data-ratio') : 'Ratio';

    // Mathematical constants & conversion factors
    var CM_FACTORS = { cm: 1, mm: 0.1, m: 100, in: 2.54, ft: 30.48 };
    var ML_PER_FL_OZ = 29.5735295625;
    var ML_PER_GAL = 3785.411784;
    var G_PER_OZ = 28.349523125;
    var G_PER_LB = 453.59237;

    // State
    var state = {
      shape: 'rectangle',
      unit: 'cm',
      length: 30,
      width: 30,
      diameter: 60,
      avgVoidWidth: 20,
      depth: 1.0,
      knownVolume: 250,
      knownVolumeUnit: 'ml',
      wastagePercent: 10,
      ratioPreset: '2:1',
      ratioA: 2,
      ratioB: 1,
      splitMode: 'volume',
      densityA: 1.15,
      densityB: 1.00
    };

    // DOM Elements
    var unitSelect = document.getElementById('dimension-unit-select');
    var inputLength = document.getElementById('input-length');
    var inputWidth = document.getElementById('input-width');
    var inputDiameter = document.getElementById('input-diameter');
    var inputVoidWidth = document.getElementById('input-voidwidth');
    var inputDepth = document.getElementById('input-depth');
    var inputKnownVolume = document.getElementById('input-known-volume');
    var knownVolumeUnitSelect = document.getElementById('known-volume-unit-select');
    var clearCalcBtn = document.getElementById('clear-calc-btn');
    var wastageSlider = document.getElementById('wastage-slider');
    var wastageBadge = document.getElementById('wastage-display-badge');
    var sliderPercentText = document.getElementById('slider-percent-text');
    var customRatioWrapper = document.getElementById('custom-ratio-wrapper');
    var customRatioA = document.getElementById('custom-ratio-a');
    var customRatioB = document.getElementById('custom-ratio-b');
    var densityAInput = document.getElementById('density-a-input');
    var densityBInput = document.getElementById('density-b-input');

    // Outputs
    var displayTotalVolume = document.getElementById('display-total-volume');
    var displayTotalFloz = document.getElementById('display-total-floz');
    var displayTotalWeightG = document.getElementById('display-total-weight-g');
    var displayTotalWeightLbs = document.getElementById('display-total-weight-lbs');
    var displayPartAMl = document.getElementById('display-part-a-ml');
    var displayPartAFloz = document.getElementById('display-part-a-floz');
    var displayPartAGrams = document.getElementById('display-part-a-grams');
    var displayPartAoz = document.getElementById('display-part-a-oz');
    var displayPartBMl = document.getElementById('display-part-b-ml');
    var displayPartBFloz = document.getElementById('display-part-b-floz');
    var displayPartBGrams = document.getElementById('display-part-b-grams');
    var displayPartBoz = document.getElementById('display-part-b-oz');
    var displaySecLiters = document.getElementById('display-sec-liters');
    var displaySecGallons = document.getElementById('display-sec-gallons');
    var displaySecKg = document.getElementById('display-sec-kg');
    var displaySecLbs = document.getElementById('display-sec-lbs');
    var displayProportionSplit = document.getElementById('display-proportion-split');
    var barPartA = document.getElementById('bar-part-a');
    var barPartB = document.getElementById('bar-part-b');
    var activeRatioBadge = document.getElementById('active-ratio-badge');
    var copyBtn = document.getElementById('copy-recipe-btn');
    var copyToast = document.getElementById('copy-toast');

    // Field wrappers
    var wrapLength = document.getElementById('field-wrapper-length');
    var wrapWidth = document.getElementById('field-wrapper-width');
    var wrapDiameter = document.getElementById('field-wrapper-diameter');
    var wrapVoidWidth = document.getElementById('field-wrapper-voidwidth');
    var wrapDepth = document.getElementById('field-wrapper-depth');
    var wrapKnownVolume = document.getElementById('field-wrapper-known-volume');
    var labelLengthText = document.getElementById('label-length-text');

    function toCm(val, unit) {
      var num = parseFloat(val);
      if (isNaN(num) || num < 0) return 0;
      return num * (CM_FACTORS[unit] || 1);
    }

    function formatNum(val, decimals) {
      if (isNaN(val) || !isFinite(val)) return '0';
      if (decimals === undefined) decimals = 1;
      return val.toLocaleString('en-US', {
        minimumFractionDigits: 0,
        maximumFractionDigits: decimals
      });
    }

    function updateShapeVisibility() {
      // Reset visibility defaults
      wrapLength.classList.remove('hidden');
      wrapWidth.classList.remove('hidden');
      wrapDiameter.classList.add('hidden');
      wrapVoidWidth.classList.add('hidden');
      if (wrapDepth) wrapDepth.classList.remove('hidden');
      if (wrapKnownVolume) wrapKnownVolume.classList.add('hidden');
      labelLengthText.textContent = STR_LENGTH;

      if (state.shape === 'circle') {
        wrapLength.classList.add('hidden');
        wrapWidth.classList.add('hidden');
        wrapDiameter.classList.remove('hidden');
      } else if (state.shape === 'river-table') {
        wrapWidth.classList.add('hidden');
        wrapVoidWidth.classList.remove('hidden');
        labelLengthText.textContent = STR_TABLE_LENGTH;
      } else if (state.shape === 'known-volume') {
        wrapLength.classList.add('hidden');
        wrapWidth.classList.add('hidden');
        wrapDiameter.classList.add('hidden');
        wrapVoidWidth.classList.add('hidden');
        if (wrapDepth) wrapDepth.classList.add('hidden');
        if (wrapKnownVolume) wrapKnownVolume.classList.remove('hidden');
      }
    }

    function calculate() {
      // Read current values
      state.unit = unitSelect.value;
      state.length = parseFloat(inputLength.value) || 0;
      state.width = parseFloat(inputWidth.value) || 0;
      state.diameter = parseFloat(inputDiameter.value) || 0;
      state.avgVoidWidth = parseFloat(inputVoidWidth.value) || 0;
      state.depth = parseFloat(inputDepth.value) || 0;
      state.wastagePercent = parseFloat(wastageSlider.value) || 0;
      state.densityA = parseFloat(densityAInput.value) || 1.15;
      state.densityB = parseFloat(densityBInput.value) || 1.00;

      if (state.ratioPreset === 'custom') {
        state.ratioA = parseFloat(customRatioA.value) || 1;
        state.ratioB = parseFloat(customRatioB.value) || 1;
      }

      // Compute volume in cm³ = ml
      var depthCm = toCm(state.depth, state.unit);
      var rawVolumeMl = 0;

      if (state.shape === 'rectangle') {
        var lCm = toCm(state.length, state.unit);
        var wCm = toCm(state.width, state.unit);
        rawVolumeMl = lCm * wCm * depthCm;
      } else if (state.shape === 'circle') {
        var dCm = toCm(state.diameter, state.unit);
        var rCm = dCm / 2;
        rawVolumeMl = Math.PI * rCm * rCm * depthCm;
      } else if (state.shape === 'oval') {
        var lCm = toCm(state.length, state.unit);
        var wCm = toCm(state.width, state.unit);
        rawVolumeMl = Math.PI * (lCm / 2) * (wCm / 2) * depthCm;
      } else if (state.shape === 'river-table') {
        var lCm = toCm(state.length, state.unit);
        var vCm = toCm(state.avgVoidWidth, state.unit);
        rawVolumeMl = lCm * vCm * depthCm;
      } else if (state.shape === 'known-volume') {
        var kv = parseFloat(inputKnownVolume ? inputKnownVolume.value : '250') || 0;
        var kvUnit = knownVolumeUnitSelect ? knownVolumeUnitSelect.value : 'ml';
        if (kvUnit === 'ml') rawVolumeMl = kv;
        else if (kvUnit === 'fl-oz') rawVolumeMl = kv * ML_PER_FL_OZ;
        else if (kvUnit === 'l') rawVolumeMl = kv * 1000;
        else if (kvUnit === 'gal') rawVolumeMl = kv * ML_PER_GAL;
      }

      var wastageFactor = 1 + (state.wastagePercent / 100);
      var totalVolumeMl = rawVolumeMl * wastageFactor;

      var partAVolumeMl = 0;
      var partBVolumeMl = 0;
      var partAWeightG = 0;
      var partBWeightG = 0;

      if (state.splitMode === 'volume') {
        var totalParts = state.ratioA + state.ratioB;
        partAVolumeMl = totalVolumeMl * (state.ratioA / totalParts);
        partBVolumeMl = totalVolumeMl * (state.ratioB / totalParts);
        partAWeightG = partAVolumeMl * state.densityA;
        partBWeightG = partBVolumeMl * state.densityB;
      } else {
        // Ratio is defined by WEIGHT
        var factor = (1 / state.densityA) + (state.ratioB / state.ratioA) * (1 / state.densityB);
        partAWeightG = totalVolumeMl / factor;
        partBWeightG = partAWeightG * (state.ratioB / state.ratioA);
        partAVolumeMl = partAWeightG / state.densityA;
        partBVolumeMl = partBWeightG / state.densityB;
      }

      var totalWeightG = partAWeightG + partBWeightG;

      // Update DOM outputs
      displayTotalVolume.textContent = formatNum(totalVolumeMl, 0);
      displayTotalFloz.textContent = formatNum(totalVolumeMl / ML_PER_FL_OZ, 1);
      displayTotalWeightG.textContent = formatNum(totalWeightG, 0);
      displayTotalWeightLbs.textContent = formatNum(totalWeightG / G_PER_LB, 2);

      displayPartAMl.textContent = formatNum(partAVolumeMl, 0);
      displayPartAFloz.textContent = formatNum(partAVolumeMl / ML_PER_FL_OZ, 1) + ' fl oz';
      displayPartAGrams.textContent = formatNum(partAWeightG, 0);
      displayPartAoz.textContent = formatNum(partAWeightG / G_PER_OZ, 1) + ' oz';

      displayPartBMl.textContent = formatNum(partBVolumeMl, 0);
      displayPartBFloz.textContent = formatNum(partBVolumeMl / ML_PER_FL_OZ, 1) + ' fl oz';
      displayPartBGrams.textContent = formatNum(partBWeightG, 0);
      displayPartBoz.textContent = formatNum(partBWeightG / G_PER_OZ, 1) + ' oz';

      displaySecLiters.textContent = formatNum(totalVolumeMl / 1000, 2) + ' L';
      displaySecGallons.textContent = formatNum(totalVolumeMl / ML_PER_GAL, 2) + ' gal';
      displaySecKg.textContent = formatNum(totalWeightG / 1000, 2) + ' kg';
      displaySecLbs.textContent = formatNum(totalWeightG / G_PER_LB, 2) + ' lbs';

      // Visual proportion bar
      var pctA = totalVolumeMl > 0 ? (partAVolumeMl / totalVolumeMl) * 100 : 50;
      var pctB = totalVolumeMl > 0 ? (partBVolumeMl / totalVolumeMl) * 100 : 50;
      barPartA.style.width = pctA.toFixed(1) + '%';
      barPartB.style.width = pctB.toFixed(1) + '%';
      displayProportionSplit.textContent = pctA.toFixed(1) + '% A : ' + pctB.toFixed(1) + '% B';

      activeRatioBadge.textContent = STR_RATIO + ' ' + state.ratioA + ':' + state.ratioB + ' (' + (state.splitMode === 'volume' ? 'Vol' : 'Wt') + ')';
    }

    // Attach Input Event Listeners
    var inputs = [inputLength, inputWidth, inputDiameter, inputVoidWidth, inputDepth, inputKnownVolume, knownVolumeUnitSelect, customRatioA, customRatioB, densityAInput, densityBInput];
    for (var i = 0; i < inputs.length; i++) {
      if (inputs[i]) {
        inputs[i].addEventListener('input', calculate);
        inputs[i].addEventListener('change', calculate);
      }
    }

    // Unit Change
    unitSelect.addEventListener('change', function() {
      var badges = document.querySelectorAll('.unit-badge');
      for (var b = 0; b < badges.length; b++) {
        badges[b].textContent = unitSelect.value;
      }
      calculate();
    });

    // Wastage Slider & Pills
    wastageSlider.addEventListener('input', function() {
      var val = wastageSlider.value;
      wastageBadge.textContent = val + '% ' + STR_BUFFER;
      sliderPercentText.textContent = val + '%';
      // Sync pill active state
      var pills = document.querySelectorAll('.wastage-pill');
      for (var p = 0; p < pills.length; p++) {
        if (pills[p].getAttribute('data-percent') === val) {
          pills[p].className = 'wastage-pill flex-1 rounded-lg border-2 border-cyan-600 bg-cyan-50/80 py-1.5 text-xs font-bold text-cyan-900 transition-all';
        } else {
          pills[p].className = 'wastage-pill flex-1 rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 transition-all';
        }
      }
      calculate();
    });

    var wastagePills = document.querySelectorAll('.wastage-pill');
    for (var wp = 0; wp < wastagePills.length; wp++) {
      wastagePills[wp].addEventListener('click', function(e) {
        var pct = this.getAttribute('data-percent');
        wastageSlider.value = pct;
        wastageBadge.textContent = pct + '% ' + STR_BUFFER;
        sliderPercentText.textContent = pct + '%';
        for (var j = 0; j < wastagePills.length; j++) {
          wastagePills[j].className = 'wastage-pill flex-1 rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 transition-all';
        }
        this.className = 'wastage-pill flex-1 rounded-lg border-2 border-cyan-600 bg-cyan-50/80 py-1.5 text-xs font-bold text-cyan-900 transition-all';
        calculate();
      });
    }

    // Shape Tabs
    var shapeTabs = document.querySelectorAll('.shape-tab');
    for (var st = 0; st < shapeTabs.length; st++) {
      shapeTabs[st].addEventListener('click', function() {
        var shape = this.getAttribute('data-shape');
        state.shape = shape;
        for (var k = 0; k < shapeTabs.length; k++) {
          shapeTabs[k].setAttribute('aria-selected', 'false');
          shapeTabs[k].className = 'shape-tab flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-slate-200 bg-slate-50/50 p-3 text-center hover:border-slate-300 transition-all cursor-pointer';
          var span = shapeTabs[k].querySelector('span');
          if (span) span.className = 'text-xs font-bold text-slate-700';
          var svg = shapeTabs[k].querySelector('svg');
          if (svg) svg.className = 'h-6 w-6 text-slate-600';
        }
        this.setAttribute('aria-selected', 'true');
        this.className = 'shape-tab flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-cyan-600 bg-cyan-50/70 p-3 text-center transition-all cursor-pointer';
        var activeSpan = this.querySelector('span');
        if (activeSpan) activeSpan.className = 'text-xs font-bold text-cyan-900';
        var activeSvg = this.querySelector('svg');
        if (activeSvg) activeSvg.className = 'h-6 w-6 text-cyan-600';

        updateShapeVisibility();
        calculate();
      });
    }

    // Ratio Buttons
    var ratioButtons = document.querySelectorAll('.ratio-btn');
    for (var rb = 0; rb < ratioButtons.length; rb++) {
      ratioButtons[rb].addEventListener('click', function() {
        var r = this.getAttribute('data-ratio');
        state.ratioPreset = r;
        for (var m = 0; m < ratioButtons.length; m++) {
          ratioButtons[m].className = 'ratio-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 transition-all';
        }
        this.className = 'ratio-btn rounded-lg border-2 border-cyan-600 bg-cyan-50/80 py-1.5 text-xs font-bold text-cyan-900 transition-all';

        if (r === 'custom') {
          customRatioWrapper.classList.remove('hidden');
          state.ratioA = parseFloat(customRatioA.value) || 1;
          state.ratioB = parseFloat(customRatioB.value) || 1;
        } else {
          customRatioWrapper.classList.add('hidden');
          var parts = r.split(':');
          state.ratioA = parseFloat(parts[0]) || 1;
          state.ratioB = parseFloat(parts[1]) || 1;
        }
        calculate();
      });
    }

    // Split Mode Toggle (Volume vs Weight)
    var modeVolBtn = document.getElementById('mode-volume-btn');
    var modeWtBtn = document.getElementById('mode-weight-btn');

    function setSplitMode(mode) {
      state.splitMode = mode;
      if (mode === 'volume') {
        modeVolBtn.className = 'mode-btn flex items-center justify-center gap-2 rounded-xl border-2 border-cyan-600 bg-cyan-50/80 px-3 py-2 text-xs font-bold text-cyan-900 transition-all';
        modeWtBtn.className = 'mode-btn flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs font-bold text-slate-700 hover:border-slate-300 transition-all';
      } else {
        modeWtBtn.className = 'mode-btn flex items-center justify-center gap-2 rounded-xl border-2 border-cyan-600 bg-cyan-50/80 px-3 py-2 text-xs font-bold text-cyan-900 transition-all';
        modeVolBtn.className = 'mode-btn flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs font-bold text-slate-700 hover:border-slate-300 transition-all';
      }
      calculate();
    }

    modeVolBtn.addEventListener('click', function() { setSplitMode('volume'); });
    modeWtBtn.addEventListener('click', function() { setSplitMode('weight'); });

    // Quick Template Presets
    var presetBtns = document.querySelectorAll('.preset-btn');
    for (var pb = 0; pb < presetBtns.length; pb++) {
      presetBtns[pb].addEventListener('click', function() {
        var shape = this.getAttribute('data-shape');
        var unit = this.getAttribute('data-unit') || 'cm';
        var length = this.getAttribute('data-length');
        var width = this.getAttribute('data-width');
        var diameter = this.getAttribute('data-diameter');
        var voidWidth = this.getAttribute('data-voidwidth');
        var depth = this.getAttribute('data-depth');
        var volume = this.getAttribute('data-volume');
        var volumeUnit = this.getAttribute('data-volumeunit');
        var ratio = this.getAttribute('data-ratio');

        if (unitSelect && unit) {
          unitSelect.value = unit;
          var badges = document.querySelectorAll('.unit-badge');
          for (var b = 0; b < badges.length; b++) {
            badges[b].textContent = unit;
          }
        }

        if (length && inputLength) inputLength.value = length;
        if (width && inputWidth) inputWidth.value = width;
        if (diameter && inputDiameter) inputDiameter.value = diameter;
        if (voidWidth && inputVoidWidth) inputVoidWidth.value = voidWidth;
        if (depth && inputDepth) inputDepth.value = depth;
        if (volume && inputKnownVolume) inputKnownVolume.value = volume;
        if (volumeUnit && knownVolumeUnitSelect) knownVolumeUnitSelect.value = volumeUnit;

        // Select shape tab
        var targetTab = document.getElementById('shape-tab-' + shape);
        if (targetTab) targetTab.click();

        // Select ratio button
        var targetRatio = document.querySelector('.ratio-btn[data-ratio="' + ratio + '"]');
        if (targetRatio) targetRatio.click();

        calculate();
      });
    }

    // Reset / Clear Calculator Button
    if (clearCalcBtn) {
      clearCalcBtn.addEventListener('click', function() {
        if (unitSelect) {
          unitSelect.value = 'cm';
          var badges = document.querySelectorAll('.unit-badge');
          for (var b = 0; b < badges.length; b++) {
            badges[b].textContent = 'cm';
          }
        }
        if (inputLength) inputLength.value = '30';
        if (inputWidth) inputWidth.value = '30';
        if (inputDiameter) inputDiameter.value = '60';
        if (inputVoidWidth) inputVoidWidth.value = '20';
        if (inputDepth) inputDepth.value = '1.0';
        if (inputKnownVolume) inputKnownVolume.value = '250';
        if (knownVolumeUnitSelect) knownVolumeUnitSelect.value = 'ml';
        if (wastageSlider) wastageSlider.value = '10';
        if (wastageBadge) wastageBadge.textContent = '10% ' + STR_BUFFER;
        if (sliderPercentText) sliderPercentText.textContent = '10%';
        if (densityAInput) densityAInput.value = '1.15';
        if (densityBInput) densityBInput.value = '1.00';

        var targetTab = document.getElementById('shape-tab-rectangle');
        if (targetTab) targetTab.click();

        var targetRatio = document.querySelector('.ratio-btn[data-ratio="2:1"]');
        if (targetRatio) targetRatio.click();

        setSplitMode('volume');
        calculate();
      });
    }

    // Quick Copy Recipe
    copyBtn.addEventListener('click', function() {
      var textToCopy = '--- EPOXY RESIN RECIPE ---\n' +
        'Project Shape: ' + state.shape + '\n' +
        'Total Batch Volume: ' + displayTotalVolume.textContent + ' ml (' + displayTotalFloz.textContent + ' fl oz)\n' +
        'Total Scale Weight: ' + displayTotalWeightG.textContent + ' g (' + displayTotalWeightLbs.textContent + ' lbs)\n' +
        'Mixing Ratio: ' + state.ratioA + ':' + state.ratioB + ' (' + state.splitMode + ')\n' +
        'Safety Margin: ' + state.wastagePercent + '%\n\n' +
        'PART A (RESIN): ' + displayPartAMl.textContent + ' ml / ' + displayPartAGrams.textContent + ' g (' + displayPartAoz.textContent + ')\n' +
        'PART B (HARDENER): ' + displayPartBMl.textContent + ' ml / ' + displayPartBGrams.textContent + ' g (' + displayPartBoz.textContent + ')\n\n' +
        'Calculated at: https://epoxyresin-calculator.com';

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(textToCopy).then(function() {
          copyToast.style.opacity = '1';
          setTimeout(function() { copyToast.style.opacity = '0'; }, 3000);
        });
      } else {
        var textArea = document.createElement('textarea');
        textArea.value = textToCopy;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        copyToast.style.opacity = '1';
        setTimeout(function() { copyToast.style.opacity = '0'; }, 3000);
      }
    });

    // Initial calculation on page load
    updateShapeVisibility();
    calculate();
  })();
</script>
