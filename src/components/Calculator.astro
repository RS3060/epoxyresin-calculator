                />
              </div>
              <div>
                <label for="custom-ratio-b" class="block text-xs font-bold text-amber-900 mb-1">
                  {c.partBLabel} ({c.ratioLabel})
                </label>
                <input 
                  type="number" 
                  id="custom-ratio-b" 
                  min="0.1" 
                  step="any" 
                  value="1" 
