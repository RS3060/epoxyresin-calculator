---
import type { Locale } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const t = translations[currentLocale] || translations.en;
const c = t.calculator;
---

<section id="calculator" class="relative py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    {/* Hero / Headline Section */}
    <div class="mx-auto max-w-3xl text-center mb-8 md:mb-12">
      <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl md:text-5xl lg:text-5xl">
        {t.hero.title}
      </h1>
      <p class="mt-4 text-base text-slate-600 sm:text-lg leading-relaxed">
        {t.hero.subtitle}
      </p>
    </div>

    {/* Quick Template Presets Bar */}
    <div class="mx-auto max-w-5xl mb-8">
      <div class="flex items-center justify-between gap-3 border-b border-slate-200 pb-3">
        <div class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-slate-500">
          <svg class="h-3.5 w-3.5 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="currentColor" fill-opacity="0.2"/>
          </svg>
          <span>{c.presetsTitle}</span>
        </div>
        <button 
          type="button" 
          id="clear-calc-btn" 
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-cyan-700 transition-colors cursor-pointer"
          title={c.clearBtn}
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span>{c.clearBtn}</span>
        </button>
      </div>
      <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-5">
        <button 
          type="button" 
          id="preset-coaster"
          class="group preset-btn flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-xs hover:border-cyan-600 hover:text-cyan-700 hover:bg-cyan-50/50 transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer"
          data-shape="rectangle" data-length="10" data-width="10" data-depth="0.5" data-unit="cm" data-ratio="1:1"
        >
          <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-cyan-600 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <circle cx="12" cy="12" r="4"/>
          </svg>
          <span>{c.presets.coaster}</span>
        </button>
        <button 
          type="button" 
          id="preset-tray"
          class="group preset-btn flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-xs hover:border-cyan-600 hover:text-cyan-700 hover:bg-cyan-50/50 transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer"
          data-shape="rectangle" data-length="30" data-width="30" data-depth="1" data-unit="cm" data-ratio="2:1"
        >
          <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-cyan-600 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="14" x="2" y="5" rx="2"/>
            <line x1="6" y1="12" x2="8" y2="12"/>
            <line x1="16" y1="12" x2="18" y2="12"/>
          </svg>
          <span>{c.presets.tray}</span>
        </button>
        <button 
          type="button" 
          id="preset-round-table"
          class="group preset-btn flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-xs hover:border-cyan-600 hover:text-cyan-700 hover:bg-cyan-50/50 transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer"
          data-shape="circle" data-diameter="60" data-depth="0.6" data-unit="cm" data-ratio="1:1"
        >
          <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-cyan-600 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <circle cx="12" cy="12" r="3.5"/>
          </svg>
          <span>{c.presets.roundTable}</span>
        </button>
        <button 
          type="button" 
          id="preset-river-table"
          class="group preset-btn flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-xs hover:border-cyan-600 hover:text-cyan-700 hover:bg-cyan-50/50 transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer"
          data-shape="river-table" data-length="120" data-voidwidth="20" data-depth="5" data-unit="cm" data-ratio="2:1"
        >
          <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-cyan-600 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 6c4-2 6 2 10 0s6 2 10 0"/>
            <path d="M2 12c4-2 6 2 10 0s6 2 10 0"/>
            <path d="M2 18c4-2 6 2 10 0s6 2 10 0"/>
          </svg>
          <span>{c.presets.riverTable}</span>
        </button>
        <button 
          type="button" 
          id="preset-mold"
          class="group preset-btn flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-xs hover:border-cyan-600 hover:text-cyan-700 hover:bg-cyan-50/50 transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer"
          data-shape="known-volume" data-volume="250" data-volumeunit="ml" data-ratio="1:1"
        >
          <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-cyan-600 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 2v7.31L4.14 18.5A2 2 0 0 0 5.86 21h12.28a2 2 0 0 0 1.72-2.5L14 9.31V2"/>
            <line x1="8.5" y1="2" x2="15.5" y2="2"/>
            <line x1="7" y1="15" x2="17" y2="15"/>
          </svg>
          <span>{c.presets.mold}</span>
        </button>
      </div>
    </div>

    {/* Main Workshop Calculator Grid */}
    <div class="mx-auto max-w-5xl grid grid-cols-1 gap-8 lg:grid-cols-12 items-start">
      
      {/* Left Column: Inputs Form (7 cols) */}
      <div class="lg:col-span-7 space-y-6">
        
        {/* Step 1: Shape Selector Tabs */}
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
          <label class="block text-sm font-bold tracking-tight text-slate-900 mb-3">
            {c.projectShape}
          </label>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5" role="tablist" aria-label="Project Shapes">
            
            {/* Rectangle */}
            <button 
              type="button" 
              role="tab"
              id="shape-tab-rectangle"
              data-shape="rectangle"
              aria-selected="true"
              class="shape-tab flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-cyan-600 bg-cyan-50/70 p-3 text-center transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer"
            >
              <svg class="h-6 w-6 text-cyan-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
              </svg>
              <span class="text-xs font-bold text-cyan-900">{c.shapes.rectangle}</span>
            </button>

            {/* Circle */}
            <button 
              type="button" 
              role="tab"
              id="shape-tab-circle"
              data-shape="circle"
              aria-selected="false"
              class="shape-tab flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-slate-200 bg-slate-50/50 p-3 text-center hover:border-slate-300 transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer"
            >
              <svg class="h-6 w-6 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
              </svg>
              <span class="text-xs font-bold text-slate-700">{c.shapes.circle}</span>
            </button>

            {/* Oval */}
            <button 
              type="button" 
              role="tab"
              id="shape-tab-oval"
              data-shape="oval"
              aria-selected="false"
              class="shape-tab flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-slate-200 bg-slate-50/50 p-3 text-center hover:border-slate-300 transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer"
            >
              <svg class="h-6 w-6 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <ellipse cx="12" cy="12" rx="9" ry="6" />
              </svg>
              <span class="text-xs font-bold text-slate-700">{c.shapes.oval}</span>
            </button>

            {/* River Table */}
            <button 
              type="button" 
              role="tab"
              id="shape-tab-river-table"
              data-shape="river-table"
              aria-selected="false"
              class="shape-tab flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-slate-200 bg-slate-50/50 p-3 text-center hover:border-slate-300 transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer"
            >
              <svg class="h-6 w-6 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <path d="M8 3c1 5-2 9 0 18" stroke="#0891b2" stroke-width="2" />
                <path d="M16 3c-1 5 2 9 0 18" stroke="#0891b2" stroke-width="2" />
              </svg>
              <span class="text-xs font-bold text-slate-700">{c.shapes.riverTable}</span>
            </button>

            {/* Known Volume (Water Displacement) */}
            <button 
              type="button" 
              role="tab"
              id="shape-tab-known-volume"
              data-shape="known-volume"
              aria-selected="false"
              class="shape-tab flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-slate-200 bg-slate-50/50 p-3 text-center hover:border-slate-300 transition-all focus-visible:outline-2 focus-visible:outline-cyan-600 cursor-pointer col-span-2 sm:col-span-1"
            >
              <svg class="h-6 w-6 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
              </svg>
              <span class="text-xs font-bold text-slate-700">{c.shapes.knownVolume}</span>
            </button>

          </div>
        </div>

        {/* Step 2: Dimensions Grid */}
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold tracking-tight text-slate-900">
              {c.dimensionsTitle}
            </h2>
            
            {/* Global Unit Switcher */}
            <div class="flex items-center gap-2">
              <label for="dimension-unit-select" class="text-xs font-semibold text-slate-500">
                {c.dimensionUnit}:
              </label>
              <select 
                id="dimension-unit-select" 
                class="rounded-lg border border-slate-300 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-800 shadow-xs focus:border-cyan-600 focus:outline-none focus:ring-2 focus:ring-cyan-600/20 cursor-pointer"
                aria-label="Measurement units"
              >
                <option value="cm" selected>{c.units.cm}</option>
                <option value="mm">{c.units.mm}</option>
                <option value="m">{c.units.m}</option>
                <option value="in">{c.units.in}</option>
                <option value="ft">{c.units.ft}</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            {/* Length Field (Rectangle, Oval, River Table) */}
            <div id="field-wrapper-length" class="space-y-1">
              <div class="flex justify-between">
                <label for="input-length" class="text-xs font-bold text-slate-700">
                  <span id="label-length-text">{c.length}</span> (<span class="unit-badge">cm</span>)
                </label>
              </div>
              <div class="relative">
                <input 
                  type="number" 
                  id="input-length" 
                  min="0.1" 
                  step="any" 
                  value="30" 
                  class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 shadow-inner focus:border-cyan-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-600/20 tabular-nums transition-colors"
                  aria-label="Project Length"
                />
              </div>
            </div>

            {/* Width Field (Rectangle, Oval) */}
            <div id="field-wrapper-width" class="space-y-1">
              <div class="flex justify-between">
                <label for="input-width" class="text-xs font-bold text-slate-700">
                  {c.width} (<span class="unit-badge">cm</span>)
                </label>
              </div>
              <div class="relative">
                <input 
                  type="number" 
                  id="input-width" 
                  min="0.1" 
                  step="any" 
                  value="30" 
                  class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 shadow-inner focus:border-cyan-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-600/20 tabular-nums transition-colors"
                  aria-label="Project Width"
                />
              </div>
            </div>

            {/* Diameter Field (Circle only - hidden by default) */}
            <div id="field-wrapper-diameter" class="space-y-1 hidden">
              <div class="flex justify-between">
                <label for="input-diameter" class="text-xs font-bold text-slate-700">
                  {c.diameter} (<span class="unit-badge">cm</span>)
                </label>
              </div>
              <div class="relative">
                <input 
                  type="number" 
                  id="input-diameter" 
                  min="0.1" 
                  step="any" 
                  value="60" 
                  class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 shadow-inner focus:border-cyan-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-600/20 tabular-nums transition-colors"
                  aria-label="Circle Diameter"
                />
              </div>
            </div>

            {/* Average Void Width Field (River Table only - hidden by default) */}
            <div id="field-wrapper-voidwidth" class="space-y-1 hidden">
              <div class="flex justify-between">
                <label for="input-voidwidth" class="text-xs font-bold text-slate-700">
                  {c.avgVoidWidth} (<span class="unit-badge">cm</span>)
                </label>
              </div>
              <div class="relative">
                <input 
                  type="number" 
                  id="input-voidwidth" 
                  min="0.1" 
                  step="any" 
                  value="20" 
                  class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 shadow-inner focus:border-cyan-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-600/20 tabular-nums transition-colors"
                  aria-label="Average Void Width"
                />
              </div>
            </div>

            {/* Depth / Thickness Field (Geometric shapes) */}
            <div id="field-wrapper-depth" class="space-y-1 sm:col-span-2">
              <div class="flex justify-between items-center">
                <label for="input-depth" class="text-xs font-bold text-slate-700">
                  {c.depth} (<span class="unit-badge">cm</span>)
                </label>
                <span class="text-[11px] text-slate-500">{c.depthSubtext}</span>
              </div>
              <div class="relative">
                <input 
                  type="number" 
                  id="input-depth" 
                  min="0.01" 
                  step="any" 
                  value="1.0" 
                  class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 shadow-inner focus:border-cyan-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-600/20 tabular-nums transition-colors"
                  aria-label="Pour Depth or Thickness"
                />
              </div>
            </div>

            {/* Known Volume Field (Irregular Molds / Water Displacement - hidden by default) */}
            <div id="field-wrapper-known-volume" class="space-y-2 sm:col-span-2 hidden">
              <div class="flex justify-between items-center">
                <label for="input-known-volume" class="text-xs font-bold text-slate-700">
                  {c.knownVolumeLabel}
                </label>
                <div class="flex items-center gap-1.5">
                  <span class="text-[11px] text-slate-500">{c.dimensionUnit}:</span>
                  <select 
                    id="known-volume-unit-select" 
                    class="rounded-md border border-slate-300 bg-slate-50 px-2 py-0.5 text-xs font-bold text-slate-800 shadow-xs focus:border-cyan-600 focus:outline-none focus:ring-1 focus:ring-cyan-600 cursor-pointer"
                    aria-label="Known volume unit"
                  >
                    <option value="ml" selected>{c.volumeUnits.ml}</option>
                    <option value="fl-oz">{c.volumeUnits.floz}</option>
                    <option value="l">{c.volumeUnits.l}</option>
                    <option value="gal">{c.volumeUnits.gal}</option>
                  </select>
                </div>
              </div>
              <p class="text-[11px] text-slate-500">
                {c.knownVolumeSubtext}
              </p>
              <div class="relative">
                <input 
                  type="number" 
                  id="input-known-volume" 
                  min="1" 
                  step="any" 
                  value="250" 
                  class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 shadow-inner focus:border-cyan-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cyan-600/20 tabular-nums transition-colors"
                  aria-label="Known Volume Amount"
                />
              </div>
            </div>

          </div>
        </div>

        {/* Step 3: Wastage / Safety Margin Buffer */}
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-sm font-bold tracking-tight text-slate-900">
              {c.wastageTitle}
            </h2>
            <span id="wastage-display-badge" class="rounded-full bg-cyan-100 px-2.5 py-0.5 text-xs font-black text-cyan-800">
              10% {c.bufferBadge}
            </span>
          </div>
          <p class="text-xs text-slate-500 mb-3">
            {c.wastageSubtext}
          </p>

          <div class="flex items-center gap-2 mb-3">
            <button 
              type="button" 
              class="wastage-pill flex-1 rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all"
              data-percent="0"
            >
              0% ({c.wastagePills.exact})
            </button>
            <button 
              type="button" 
              class="wastage-pill flex-1 rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all"
              data-percent="5"
            >
              5% ({c.wastagePills.standard})
            </button>
            <button 
              type="button" 
              class="wastage-pill flex-1 rounded-lg border-2 border-cyan-600 bg-cyan-50/80 py-1.5 text-xs font-bold text-cyan-900 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all"
              data-percent="10"
            >
              10% ({c.wastagePills.recommended})
            </button>
          </div>

          <div class="flex items-center gap-3">
            <input 
              type="range" 
              id="wastage-slider" 
              min="0" 
              max="25" 
              step="1" 
              value="10"
              class="w-full cursor-pointer"
              aria-label="Wastage safety margin percentage slider"
            />
            <span class="text-xs font-bold text-slate-700 w-10 text-right tabular-nums" id="slider-percent-text">10%</span>
          </div>
        </div>

        {/* Step 4: Mixing Ratio & Calculation Mode */}
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs space-y-5">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-sm font-bold tracking-tight text-slate-900">
                {c.ratioTitle}
              </h2>
            </div>
            
            {/* Ratio Presets */}
            <div class="grid grid-cols-4 sm:grid-cols-8 gap-1.5" role="radiogroup" aria-label="Manufacturer Mixing Ratio Presets">
              <button type="button" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-ratio="1:1">1:1</button>
              <button type="button" class="ratio-btn rounded-lg border-2 border-cyan-600 bg-cyan-50/80 py-1.5 text-xs font-bold text-cyan-900 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-ratio="2:1">2:1</button>
              <button type="button" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-ratio="3:1">3:1</button>
              <button type="button" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-ratio="4:1">4:1</button>
              <button type="button" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-ratio="100:50">100:50</button>
              <button type="button" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-ratio="100:45">100:45</button>
              <button type="button" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-ratio="100:30">100:30</button>
              <button type="button" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 py-1.5 text-xs font-bold text-slate-700 hover:border-slate-300 focus-visible:outline-2 focus-visible:outline-cyan-600 transition-all" data-ratio="custom">{c.customRatio}</button>
