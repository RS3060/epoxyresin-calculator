---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  locale="en" 
  customTitle="500: System Error — EpoxyResin-Calculator.com"
  customDescription="An unexpected error occurred while processing this calculation. Return to our precision epoxy resin calculator and workshop tools."
  showLanguageSelector={false}
  noindex={true}
>
  <div class="py-16 sm:py-24 bg-white flex items-center justify-center">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 text-center">
      
      {/* Status Badge */}
      <div class="inline-flex items-center gap-2 rounded-full bg-amber-50 border border-amber-200/80 px-3.5 py-1 text-xs font-bold text-amber-800 mb-6">
        <span class="h-2 w-2 rounded-full bg-amber-500"></span>
        500 • Exotherm Anomaly
      </div>

      {/* Large Code */}
      <h1 class="text-7xl sm:text-9xl font-black tracking-tighter bg-gradient-to-br from-slate-900 via-amber-700 to-slate-800 bg-clip-text text-transparent select-none mb-2">
        500
      </h1>

      {/* Headline & Description */}
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mb-4">
        Unexpected Workshop Error
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-lg mx-auto mb-8">
        The calculation engine encountered an unexpected internal issue while processing this request. Your data was not lost because calculations run locally in your browser.
      </p>

      {/* Action Buttons */}
      <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
        <a 
          href="/" 
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-600 px-6 py-3 text-xs sm:text-sm font-bold text-white shadow-md shadow-cyan-600/20 hover:bg-cyan-500 hover:shadow-lg transition-all focus-visible:outline-2 focus-visible:outline-cyan-600"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Return to Calculator
        </a>
        <button 
          onclick="window.location.reload()" 
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-6 py-3 text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 hover:border-slate-300 transition-all cursor-pointer"
        >
          <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Reload Page
        </button>
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-6 py-3 text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-all"
        >
          Report Issue
        </a>
      </div>

      {/* Troubleshooting Tips */}
      <div class="rounded-2xl border border-slate-200/80 bg-slate-50/70 p-6 text-left">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
          Troubleshooting Checklist
        </p>
        <ul class="text-xs text-slate-600 space-y-1.5 list-disc list-inside">
          <li>Ensure JavaScript is enabled in your browser preferences.</li>
          <li>Try hard-refreshing the page (<kbd class="px-1.5 py-0.5 rounded bg-white border border-slate-200 text-[10px] font-mono">Ctrl + Shift + R</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-white border border-slate-200 text-[10px] font-mono">Cmd + Shift + R</kbd>).</li>
          <li>If the problem persists, drop a line to <a href="/contact" class="text-cyan-700 underline font-medium hover:text-cyan-800">our workshop engineering team</a>.</li>
        </ul>
      </div>

    </div>
  </div>
</Layout>
